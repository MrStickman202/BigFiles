<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the UI-independent logic (grouping, scanning bookkeeping, "Smaller files" math, delete planning)
       on any OS with "dotnet run" in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\BigFiles\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
