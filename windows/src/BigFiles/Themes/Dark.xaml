<!-- Colors for the Dark theme. Styles.xaml uses these keys through DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBg" Color="#202020" />
    <SolidColorBrush x:Key="PanelBg" Color="#272727" />
    <SolidColorBrush x:Key="Fg" Color="#F2F2F2" />
    <SolidColorBrush x:Key="FgMuted" Color="#A8A8A8" />
    <SolidColorBrush x:Key="FgDisabled" Color="#6B6B6B" />
    <SolidColorBrush x:Key="Border" Color="#383838" />
    <SolidColorBrush x:Key="ControlBg" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ControlBorder" Color="#454545" />
    <SolidColorBrush x:Key="ControlHover" Color="#363636" />
    <SolidColorBrush x:Key="ControlPressed" Color="#3F3F3F" />
    <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHover" Color="#5B96F7" />
    <SolidColorBrush x:Key="AccentPressed" Color="#2F6FD8" />
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RowHover" Color="#303030" />
    <SolidColorBrush x:Key="RowSelected" Color="#21406E" />
    <SolidColorBrush x:Key="RowSelectedInactive" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#5C5C5C" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#7A7A7A" />
    <SolidColorBrush x:Key="Link" Color="#7FB2FF" />
    <SolidColorBrush x:Key="Danger" Color="#E0473A" />
    <SolidColorBrush x:Key="DangerHover" Color="#F06357" />
    <SolidColorBrush x:Key="Overlay" Color="#80202020" />
    <!-- Built-in templates (scroll corner, menus) read these system brushes. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2D2D2D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#272727" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F2F2F2" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F2F2F2" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6B6B6B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#21406E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F2F2F2" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3A3A3A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F2F2F2" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2D2D2D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F2F2F2" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#383838" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#454545" />
</ResourceDictionary>
