<!-- Colors for the Light theme. Styles.xaml uses these keys through DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBg" Color="#F7F7F7" />
    <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Fg" Color="#1B1B1B" />
    <SolidColorBrush x:Key="FgMuted" Color="#5F5F5F" />
    <SolidColorBrush x:Key="FgDisabled" Color="#A0A0A0" />
    <SolidColorBrush x:Key="Border" Color="#E3E3E3" />
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorder" Color="#CFCFCF" />
    <SolidColorBrush x:Key="ControlHover" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ControlPressed" Color="#E9E9E9" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressed" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RowHover" Color="#F1F3F7" />
    <SolidColorBrush x:Key="RowSelected" Color="#D7E4FC" />
    <SolidColorBrush x:Key="RowSelectedInactive" Color="#E6E6E6" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#C4C4C4" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A6A6A6" />
    <SolidColorBrush x:Key="Link" Color="#1D5FD6" />
    <SolidColorBrush x:Key="Danger" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerHover" Color="#A52416" />
    <SolidColorBrush x:Key="Overlay" Color="#80FFFFFF" />
    <!-- Built-in templates (scroll corner, menus) read these system brushes. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1B1B1B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1B1B1B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#A0A0A0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D7E4FC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B1B1B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E6E6E6" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B1B1B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#1B1B1B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#E3E3E3" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#CFCFCF" />
</ResourceDictionary>
