<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BigFiles</AssemblyName>
    <RootNamespace>BigFiles</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BigFiles.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>BigFiles</Product>
    <Company>BigFiles</Company>
    <Authors>BigFiles</Authors>
    <Copyright></Copyright>
    <Description>Shows what takes up disk space, grouped by the app it belongs to.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Lets the project build on non-Windows machines too (the app itself only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- One self-contained .exe for 64-bit Windows: no .NET install needed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\BigFiles.ico" />
  </ItemGroup>

</Project>
