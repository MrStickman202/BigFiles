<Window x:Class="BigFiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BigFiles" Width="1140" Height="720" MinWidth="780" MinHeight="440"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        Icon="pack://application:,,,/BigFiles;component/Assets/BigFiles.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0" Padding="12,10" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ComboBox x:Name="ScopeBox" Width="220" ToolTip="What to scan" SelectionChanged="ScopeBox_SelectionChanged">
                        <ComboBoxItem Tag="apps" Content="Apps &amp; User folder" />
                        <ComboBoxItem Tag="pc" Content="Whole PC" />
                        <ComboBoxItem Tag="choose" Content="Choose folder…" />
                    </ComboBox>
                    <ComboBox x:Name="MinSizeBox" Width="104" Margin="8,0,0,0" ToolTip="Only show items at least this big"
                              SelectionChanged="MinSizeBox_SelectionChanged" />
                    <Button x:Name="ScanButton" Margin="8,0,0,0" MinWidth="104" Click="ScanButton_Click" ToolTip="Scan again (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ScanIcon" FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock x:Name="ScanText" Text="Scan" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="280" Tag="Filter by name or path   (Ctrl+F)"
                         TextChanged="SearchBox_TextChanged" />
                <Border />
            </DockPanel>
        </Border>

        <!-- ===== Results ===== -->
        <Grid Grid.Row="1" Background="{DynamicResource PanelBg}">
            <ListView x:Name="Tree" Visibility="Collapsed" SelectionMode="Extended"
                      PreviewKeyDown="Tree_PreviewKeyDown" SizeChanged="Tree_SizeChanged"
                      ContextMenuOpening="Tree_ContextMenuOpening">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn x:Name="NameCol" Width="430">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Name" Content="Name" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="{Binding Indent}" Height="24">
                                        <Border DockPanel.Dock="Left" Tag="toggle" Width="18" Height="24" Background="Transparent"
                                                Visibility="{Binding ToggleVisibility}" Cursor="Hand"
                                                MouseLeftButtonDown="Toggle_MouseLeftButtonDown">
                                            <Path Data="M 0 0 L 4 4 L 0 8" Stroke="{DynamicResource FgMuted}" StrokeThickness="1.5"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="{Binding ArrowAngle}" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Border>
                                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="2,0,8,0"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}" ToolTip="{Binding Tooltip}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="SizeCol" Width="104">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Size" Content="Size" HorizontalContentAlignment="Right" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" FontWeight="{Binding Weight}" TextAlignment="Right"
                                               Margin="0,0,6,0" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="KindCol" Width="90">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Kind" Content="Kind" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding KindText}" Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="LocationCol" Width="420">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Location" Content="Location" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Location}" ToolTip="{Binding LocationTooltip}" Foreground="{DynamicResource FgMuted}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="MenuShow" Header="Show in Explorer" InputGestureText="Enter" Click="MenuShow_Click" />
                        <MenuItem x:Name="MenuOpen" Header="Open" Click="MenuOpen_Click" />
                        <MenuItem x:Name="MenuCopy" Header="Copy path" InputGestureText="Ctrl+C" Click="MenuCopy_Click" />
                        <Separator />
                        <MenuItem x:Name="MenuUninstall" Header="Uninstall…" Click="MenuUninstall_Click" />
                        <MenuItem x:Name="MenuRecycle" Header="Move to Recycle Bin…" InputGestureText="Del" Click="MenuRecycle_Click" />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <!-- Shown while scanning and when nothing matches. -->
            <StackPanel x:Name="Message" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Visibility="Collapsed">
                <TextBlock x:Name="MessageTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageBody" Foreground="{DynamicResource FgMuted}" Margin="0,6,0,0" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Before the first scan. -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Image x:Name="EmptyIcon" Width="72" Height="72" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="See what takes up space on your PC" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Margin="0,18,0,6" />
                <TextBlock Text="BigFiles groups your disk by the app it belongs to — install folder and data together."
                           Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Style="{StaticResource AccentButton}" Content="Scan Apps &amp; User folder" Padding="16,7" Click="EmptyScanApps_Click" />
                    <Button Content="Scan Whole PC" Padding="16,7" Margin="8,0,0,0" Click="EmptyScanPc_Click" />
                    <Button Content="Choose folder…" Padding="16,7" Margin="8,0,0,0" Click="EmptyChoose_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Canvas x:Name="ProgressTrack" Height="2" VerticalAlignment="Top" ClipToBounds="True" Visibility="Collapsed"
                        SizeChanged="ProgressTrack_SizeChanged">
                    <Rectangle Width="160" Height="2" Fill="{DynamicResource Accent}">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ProgressMove" X="-160" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
                <TextBlock x:Name="StatusLine" Margin="12,7,12,7" TextTrimming="CharacterEllipsis">
                    <Run x:Name="StatusMain" Text="Ready" /><Run x:Name="StatusMuted" Foreground="{DynamicResource FgMuted}" /><Run x:Name="StatusGap" /><Hyperlink x:Name="ErrorsLink" Click="ErrorsLink_Click"><Run x:Name="ErrorsText" /></Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
